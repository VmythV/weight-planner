# 复制为 .env 后填写（.env 已加入 .gitignore，不要提交）。环境变量同名时优先于这里。

# 网页登录密码。不填则不做任何验证，只适合本机开发
WP_PASSWORD=

# 给 ESP32 和其他系统用的 API 令牌，逗号分隔，格式：名称:令牌
# 生成令牌：python3 -c "import secrets; print(secrets.token_hex(24))"
# 请求时放在请求头 Authorization: Bearer <令牌> 或 X-API-Key: <令牌>
WP_API_TOKENS=esp32:

# 登录有效天数
WP_SESSION_DAYS=30

# 数据库位置，默认 data/weight.db
# WP_DB=/path/to/weight.db
